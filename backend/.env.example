# ============================================================
# DisNotify backend — copy to `.env` and fill in.
# NEVER commit the real .env file.
# ============================================================

NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Region / money. ZAR prices are VAT-inclusive — never add 15% anywhere.
DEFAULT_REGION=ZA
DEFAULT_CURRENCY=ZAR
DEFAULT_TIMEZONE=Africa/Johannesburg

# ---------- Database ----------
DATABASE_URL=postgres://postgres:password@localhost:5432/disnotify
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------- Web Push (npx web-push generate-vapid-keys) ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Email ----------
RESEND_API_KEY=
MAIL_FROM=DisNotify <alerts@yourdomain.co.za>

# ---------- SMS (optional, costs money per message) ----------
# SA providers: Clickatell, BulkSMS, SMSPortal, Panacea Mobile.
# Twilio also works but check per-message pricing to ZA numbers.
SMS_PROVIDER=clickatell
SMS_API_KEY=
SMS_FROM=

# ---------- Retailer sources (see docs/SCRAPING_VS_API.md) ----------
# NOTE: no major South African retailer offers a public product API.
# Everything here is an affiliate/partner credential you must APPLY for,
# or is left empty because you scrape that retailer instead.
# Every adapter MUST skip its retailer when its credentials are blank —
# a missing key is a config state, not an error.

# Takealot affiliate programme (via an affiliate network).
# Apply on day one; approval is not instant.
TAKEALOT_AFFILIATE_ID=
TAKEALOT_FEED_URL=
TAKEALOT_API_KEY=

# PriceCheck partner/affiliate access — one integration, many SA merchants
PRICECHECK_API_KEY=
PRICECHECK_FEED_URL=

# Amazon.co.za — Associates ZA + PA-API.
# CONFIRM PA-API supports the .co.za marketplace before relying on this.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=
AMAZON_REGION=

# ---------- Scraping ----------
# Residential/rotating proxy for the retailers with no API. Format:
# http://user:pass@gateway.provider.com:port
PROXY_URL=
SCRAPE_USER_AGENT=DisNotifyBot/0.1 (+https://yourdomain.co.za/bot)
SCRAPE_CONCURRENCY=2
SCRAPE_DELAY_MS=4000
